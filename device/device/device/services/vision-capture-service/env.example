# ========= Identity =========
TENANT=t1
HOUSE=h01
STATION=st01
CAM_ID=cam01

# ========= Camera =========
# USB index (0,1,...) หรือใส่ RTSP/HTTP URL ก็ได้ เช่น:
# CAMERA_SOURCE=rtsp://user:pass@camera.local:554/stream1
CAMERA_SOURCE=d435
RESOLUTION=640x480
FPS=30
IMG_FORMAT=jpg
DEPTH_MM_SCALE=1.0       # คูณเพื่อชดเชยกำลังขยาย (ถ้าไม่ต้องปรับให้คง 1)
DEPTH_MM_OFFSET=-7.5   # mm ที่ต้องบวกหลังแปลง (ใช้ค่าจริง - ค่าที่วัดจาก depth)
CAPTURE_ROI=210,120,500,460

# ========= Local paths =========
MEDIA_DIR=/home/qiadmin-server/FarmIQ/device/services/vision-capture-service/media
SPOOL_DIR=/home/qiadmin-server/FarmIQ/device/services/vision-capture-service/spool

# ========= Ingestion HTTP API =========
INGEST_BASE_URL=http://192.168.1.121:8080
INGEST_API_PATH=/api/v1/images/upload
UPLOAD_ENABLED=false

# ========= MQTT =========
# รูปแบบ: mqtt://USER:PASS@HOST:PORT
MQTT_BROKER_URL=mqtt://192.168.1.121:1883
MQTT_USER=admin
MQTT_PASSWORD=admin1234
MQTT_QOS=1
MQTT_KEEPALIVE=30
MQTT_ENABLED=false

# ========= Scheduler (เปิดอย่างใดอย่างหนึ่ง) =========
#CRON=*/1 * * * *          # ตัวอย่าง: ถ่ายทุก 1 นาที
INTERVAL_SEC=15            # หรือ: ถ่ายทุก 15 วินาที (ปรับลดเพื่อทดสอบ)

# ========= HTTP server =========
IMAGE_INGESTION_PORT=8181

# ========= Misc =========
LOG_LEVEL=INFO
VERIFY_TLS=false           # ถ้า INGEST_BASE_URL เป็น https และมี cert ให้ตั้ง true

# CORS Settings
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Additional settings
API_KEY=d6dbbc7685977e5d8e0e6dac701ef19d2c0203877af0c64cbf0a2753ef9a406eae6463e42ec44037571e19833d9babcf383c4a4df9e1b1b3da0e0fa5a7b43780
API_KEY_ID=cam01
USE_REQUEST_SIGNING=true

# โหมดทริกเกอร์: cron | interval | robot | mixed
CAPTURE_MODE=interval

# สำหรับ robot-trigger
SETTLE_MS=250            # หน่วงให้ภาพนิ่งก่อนถ่าย
BURST_COUNT=1            # ถ่ายหลายใบตอน robot หยุด (เช่น 3)
BURST_INTERVAL_MS=120
BLUR_VAR_MIN=120.0       # เกณฑ์ความคม (Laplacian variance) ต่ำกว่านี้ถือว่าเบลอ ให้รีทราย
MAX_RETRIES=2            # รีทรายหากเบลอ (รวมกับ burst ได้)

# ---- Presence detection ----
PRESENCE_MODE=motion        # none | motion
PRESENCE_MIN_AREA=1500      # พิกเซลขั้นต่ำของคอนทัวร์ที่ถือว่า "มีวัตถุ"
PRESENCE_MIN_FRAMES=3       # ต้องเจอติดกันกี่เฟรม
PRESENCE_TIMEOUT_MS=5000    # รอสูงสุดกี่ ms ตอนสั่งถ่ายแบบ only_if_present
PRESENCE_ROI=               # ตัวอย่าง "100,100,600,400" (x1,y1,x2,y2) ว่าง=ทั้งภาพ
COOLDOWN_SEC=2              # เวลาพักหลังถ่าย 1 ครั้ง กันรัว

# ---- Scale (เครื่องชั่ง) ----
SCALE_ID=sc01
SCALE_ENABLED=true
SCALE_PORT=/dev/ttyUSB0
SCALE_BAUD=9600
SCALE_MIN_GRAMS=50          # ต้องมากกว่านี้ถึงจะนับว่ามีวัตถุบนเครื่องชั่ง
SCALE_STABLE_DELTA=2        # กรัม | ช่วงแกว่งที่ยอมได้
SCALE_STABLE_MS=800         # ต้องนิ่งกี่ ms
SCALE_TIMEOUT_MS=6000       # รอสูงสุดตอนบังคับ "wait_weight"
SCALE_DEFAULT_UNIT=kg
WAIT_WEIGHT_DEFAULT=true
WEIGHT_SESSION_DELTA_G=50          # ต่างเกิน 50 g ถือว่า session ใหม่
WEIGHT_SESSION_COOLDOWN_SEC=30     # หรือถ้าอยากบันทึกซ้ำหลัง x วินาที แม้ น้ำหนักใกล้เคียงกัน
