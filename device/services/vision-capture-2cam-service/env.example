# ========= Identity =========
TENANT=t1
HOUSE=h01
STATION=st01
RIG_ID=rig01

# ========= Camera (HIKVISION DS-2CD2043G2-I) =========
LEFT_CAMERA_URL=rtsp://admin:password@169.254.104.42:554/Streaming/Channels/101
RIGHT_CAMERA_URL=rtsp://admin:password@169.254.47.99:554/Streaming/Channels/101
RESOLUTION=1280x720
FPS=30
FOCAL_PX=1500.0            # ประมาณสำหรับเลนส์ 4 mm @ 1280px
BASELINE_M=0.12            # เริ่มที่ 12 ซม. (เพิ่มเป็น 0.15 ได้ถ้าต้องการ)
ROI_FRACTION=0.65          # ใช้เฉพาะโซนกลาง 60–70% ของภาพ

# ========= Stereo Processing =========
STEREO_CALIB_PATH=calib/stereo.example.yml
NUM_DISPARITIES=256
BLOCK_SIZE=5
UNIQUENESS_RATIO=10
SPECKLE_WINDOW=50
SPECKLE_RANGE=2
DISP12_MAX_DIFF=1
HEIGHT_THRESHOLD_MM=30     # ความสูงเหนือระนาบขั้นต่ำที่จะนับว่าเป็นวัตถุ
PLANE_SAMPLE_SIZE=6000     # จำนวนจุดสุ่มสำหรับ fit ระนาบถาด
MEDIAN_BLUR_KSIZE=3

# ========= Output Paths =========
MEDIA_DIR=/home/qiadmin-server/FarmIQ/device/services/vision-capture-2cam-service/media
SPOOL_DIR=/home/qiadmin-server/FarmIQ/device/services/vision-capture-2cam-service/spool
UPLOAD_ENABLED=false

# ========= Scheduler =========
CAPTURE_INTERVAL_SEC=15
RUN_ONCE=false

# ========= Logging / Misc =========
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_DELAY_SEC=2
WAIT_MS_BETWEEN_FRAMES=100
