# MQTT Configuration
#MQTT_URL=mqtt://localhost:1883
MQTT_URL=mqtt://edge_admin:admin1234@localhost:1883  #กรณี Mockup อยูในเครื่องเดียวกันกับ mqtt-service
MQTT_URL=mqtt://edge_admin:admin1234@192.168.1.121:1883 #กรณี Mockup อยูคนละเครื่องกับ mqtt-service

# Sensor Features
ENV_SENSORS_ENABLED=true
WATER_SENSORS_ENABLED=true
FEED_SENSOR_ENABLED=true

# Vision and Capture
#CAPTURE_ENABLED=false
VISION_INFERENCE_ENABLED=false

#--เพิ่ม--
CAPTURE_ENABLED=true
CAPTURE_INGEST_URL=http://localhost:6304/api/ingest/image
CAPTURE_INGEST_URL=http://192.168.1.121:6304/api/ingest/image

# Timing Configuration (optional - using defaults)
ENV_SENSOR_INTERVAL_MS=60000
WATER_SENSOR_INTERVAL_MS=60000
WEIGHT_READING_INTERVAL_MS=60000
DAY_ADVANCE_INTERVAL_MS=3600000

# Growth Configuration (optional - using defaults)
START_WEIGHT_KG=0.8
TARGET_WEIGHT_KG=2.95
GROWTH_DAYS=60

# Weight Configuration (optional - using defaults)
WEIGHT_BATCH_SIZE=20
WEIGHT_INCLUDE_PREDICTION=false

# Animals Configuration (optional - using defaults)
ANIMALS_PER_HOUSE=450

# Image capture mock (uploads to image-ingestion/minio)
CAPTURE_ENABLED=true
CAPTURE_MEDIA_DIR=./tmp/mock-capture
CAPTURE_INGEST_URL=http://localhost:6304/api/ingest/image
CAPTURE_INGEST_URL=http://192.168.1.121:6304/api/ingest/image
CAPTURE_IMAGE_METRIC=image
CAPTURE_INGEST_API_KEY=admin-key
