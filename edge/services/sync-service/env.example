NODE_ENV=development
LOG_LEVEL=info
PORT=6302
HOST=0.0.0.0

# Database Configuration (Required)
DATABASE_URL="postgresql://postgres:postgres1611@localhost:15432/farmiq_edge"

# MQTT Configuration (Required)
MQTT_BROKER_URL=mqtt://edge-mqtt:1883
