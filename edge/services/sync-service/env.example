# API Configuration
API_KEY=admin-key

# Sync Service specific
CLOUD_API_URL=http://host.docker.internal:7302
CLOUD_API_KEY=admin-key
SYNC_INTERVAL_MINUTES=5
SYNC_MAX_RETRIES=3
SYNC_BACKOFF_MS=1000